# Neon PostgreSQL connection string. Keep this server-side; never prefix it with VITE_.
DATABASE_URL=

GROQ_API_KEY=
# Groq model configured for strict JSON-schema Structured Outputs.
GROQ_MODEL=

# Clerk client key exposed to the Vite application.
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk server credentials. Never expose CLERK_SECRET_KEY through VITE_.
CLERK_SECRET_KEY=
# Optional server-side publishable key and comma-separated trusted origins.
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Optional client-safe error reporting DSN.
VITE_SENTRY_DSN=
