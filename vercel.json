{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/router?path=:path"
    },
    {
      "source": "/((?!api/|src/|@vite/|@react-refresh|@fs/|@id/|node_modules/|assets/|images/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
