{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/router?path=:path"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/my-pets",
      "destination": "/index.html"
    },
    {
      "source": "/pets/:petId/cases/:caseId",
      "destination": "/index.html"
    }
  ]
}
